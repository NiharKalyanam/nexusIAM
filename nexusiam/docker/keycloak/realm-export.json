      { "name": "nexusiam-admin", "description": "NexusIAM Administrator" },
      { "name": "nexusiam-user", "description": "NexusIAM Standard User" },
      { "name": "nexusiam-auditor", "description": "NexusIAM Auditor" }
    ]
  },
  "users": [
    {
      "username": "admin",
